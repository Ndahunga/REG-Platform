VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=OuWealth Community
VITE_APP_ENV=development
# Phase 12: set true to register the service worker / enable install UX.
# SW caches app shell only — never offline financial mutations.
VITE_ENABLE_PWA=true
# Local UI preview login (fake token). Default false. NEVER enable in production/staging.
# Requires Vite DEV mode AND VITE_ENABLE_PREVIEW_LOGIN=true.
VITE_ENABLE_PREVIEW_LOGIN=false
