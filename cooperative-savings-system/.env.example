# =============================================================================
# TERIMBERE Cooperative Savings Account Management System (CSAMS)
# Safe environment template — copy to .env and fill in real values.
# Never commit real secrets.
# =============================================================================

# --- Application ---
APP_NAME=TERIMBERE-CSAMS
APP_ENV=local
APP_TIMEZONE=Africa/Kigali

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cooperative_savings_db
POSTGRES_USER=csams_user
POSTGRES_PASSWORD=change_me_strong_password

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_at_least_64_chars_xxxxxxxx
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_at_least_64_chars_yyy
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- File storage (local) ---
FILE_STORAGE_TYPE=local
FILE_STORAGE_BASE_PATH=./uploads
MAX_FILE_SIZE_MB=10

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=OuWealth Community
VITE_APP_ENV=local
VITE_ENABLE_PWA=false
# Never enable in production/staging. Requires Vite DEV mode as well.
VITE_ENABLE_PREVIEW_LOGIN=false

# Production profile notes:
# - SPRING_PROFILES_ACTIVE=production refuses local JWT defaults and blank POSTGRES_* vars
# - Replace JWT_* with long random secrets (>= 64 chars)
# - Set CORS_ALLOWED_ORIGINS to the real frontend origin(s)
# - Set VITE_API_BASE_URL to the real API origin (not a placeholder host)

# --- Email (optional SMTP; see documentation/development/notifications-external.md) ---
# Leave MAIL_HOST / MAIL_FROM blank for local/dev: the email channel skips safely.
# Password-reset email is not implemented yet (reset still only logs a token in local profile).
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
MAIL_HEALTH_ENABLED=false

# --- WhatsApp Cloud API (optional; report sharing and in-app notification delivery) ---
# Leave disabled unless a Meta WhatsApp Business Cloud API app is configured.
# Never put tokens in the frontend. Download PDF and in-app notifications work without these.
# WHATSAPP_TEMPLATE_NAME is a DOCUMENT header template for report PDFs only — not used for notification text.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional pre-approved template with a DOCUMENT header (needed outside the 24h session window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- MTN Mobile Money Collection (optional; OuWealth subscription checkout) ---
# Leave disabled for local development. Never commit real keys. OuWealth never collects a MoMo PIN.
# Required secrets when enabled: MTN_MOMO_SUBSCRIPTION_KEY, MTN_MOMO_API_USER, MTN_MOMO_API_KEY
# Required public URL when enabled in production: MTN_MOMO_CALLBACK_URL (HTTPS, not localhost)
# Explicit environment: sandbox (dev) | mtnrwanda (or other production Collection env)
MTN_MOMO_ENABLED=false
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=

# --- Flutterwave hosted checkout (optional; OuWealth Bank Card subscription payments) ---
# Leave disabled for local development. Never commit real keys.
# OuWealth never collects or stores PAN, expiry, or CVV — Flutterwave hosted checkout does.
# Required secrets when enabled: FLUTTERWAVE_SECRET_KEY, FLUTTERWAVE_SECRET_HASH
# Required public URLs: FLUTTERWAVE_REDIRECT_URL, FLUTTERWAVE_WEBHOOK_URL (HTTPS in production)
# Explicit mode: test | live (production profile rejects test)
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_MODE=test
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_REDIRECT_URL=http://localhost:5173/billing/payment-return
FLUTTERWAVE_WEBHOOK_URL=
# Checkout retry window (minutes). Not provider final status — expiry does not mark FAILED.
SUBSCRIPTION_PENDING_REUSE_MINUTES=15
# PENDING older than this (hours) are skipped by reconciliation sweeps.
SUBSCRIPTION_PENDING_ABANDON_HOURS=48
# Missed-callback recovery (default off locally; enable in staging/production).
SUBSCRIPTION_RECONCILIATION_ENABLED=false
SUBSCRIPTION_RECONCILIATION_FIXED_DELAY_MS=300000
SUBSCRIPTION_RECONCILIATION_INITIAL_DELAY_MS=60000
SUBSCRIPTION_RECONCILIATION_MIN_AGE_MINUTES=2
SUBSCRIPTION_RECONCILIATION_BATCH_SIZE=50

# --- Member payments: verification and provider callbacks ---
# Secure default (true): a payment is verified and posted only on authoritative confirmation (an officer's cash
# confirmation, an imported statement line, or a signed provider callback). Never set false in production.
APP_PAYMENTS_REQUIRE_TRUSTED_CONFIRMATION=true
# Signed provider callbacks (POST /api/v1/public/payment-callbacks/{channel}). A blank secret disables the channel (503).
# Generate each secret with a password manager or `openssl rand -hex 32`; never commit a real value.
# Headers: X-Timestamp (epoch seconds) and X-Signature = hex HMAC-SHA256(secret, timestamp + "." + raw body).
PAYMENT_CALLBACK_SECRET_MTN_MOMO=
PAYMENT_CALLBACK_SECRET_AIRTEL_MONEY=
PAYMENT_CALLBACK_SECRET_BANK_TRANSFER=
PAYMENT_CALLBACK_SECRET_OTHER=
PAYMENT_CALLBACK_REPLAY_WINDOW_SECONDS=300
PAYMENT_CALLBACK_MAX_FUTURE_SKEW_SECONDS=60
# In-process abuse limits per application instance (0 disables); the reverse proxy must still rate-limit the endpoint.
PAYMENT_CALLBACK_RATE_PER_ADDRESS_PER_MINUTE=60
PAYMENT_CALLBACK_RATE_PER_CHANNEL_PER_MINUTE=600
# Receipt reading (optional): needs the tesseract binary on the server. Advisory only; it never confirms a payment.
APP_OCR_TESSERACT_PATH=tesseract
APP_OCR_TESSERACT_LANGUAGE=eng
APP_OCR_TIMEOUT_SECONDS=30
APP_OCR_MAX_BYTES=8388608
# Receipt wording specific to this deployment, ADDED to the built-in English and Kinyarwanda vocabulary (never replacing it).
# Comma-separated phrases that mean the receipt shows success / failure / pending / a neutral heading / a past-transactions
# list. A receipt is only ever classified as an advisory reading: success never verifies or posts a payment.
# (Spring binds app.payments.receipt-vocabulary.extra-success from APP_PAYMENTS_RECEIPTVOCABULARY_EXTRASUCCESS, and so on.)
APP_PAYMENTS_RECEIPTVOCABULARY_EXTRASUCCESS=
APP_PAYMENTS_RECEIPTVOCABULARY_EXTRAFAILED=
APP_PAYMENTS_RECEIPTVOCABULARY_EXTRAPENDING=
APP_PAYMENTS_RECEIPTVOCABULARY_EXTRANEUTRAL=
APP_PAYMENTS_RECEIPTVOCABULARY_EXTRAHISTORYMARKERS=

# --- Seed ---
# Automated tests only. Never enable default admin for boss/UAT/production.
APP_SEED_DEFAULT_ADMIN=false
